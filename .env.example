# Universe Imagine MCP — .env.example
# Copy this to .env and fill in your values.
#
#   cp .env.example .env
#
# Required:
#   DESIGNER_MCP_TOKEN   — Bearer token for the /mcp endpoint
#   PUBLIC_URL_BASE      — Public URL where images are served (e.g. https://imagine.example.com)
#
# Optional — omit or leave blank to skip:
#   DISCORD_WEBHOOK_URL  — Discord webhook URL for generation notifications
#   HOST                 — Listen address (default: 0.0.0.0)
#   PORT                 — MCP server port (default: 8003)
#   COMFYUI_URL          — ComfyUI API URL (default: http://127.0.0.1:8188)
#   COMFYUI_DIR          — ComfyUI install directory (default: ~/ComfyUI)
#   DB_PATH              — SQLite database path (default: ./imagine.db)
#   OUTPUT_DIR           — ComfyUI output directory (default: ~/ComfyUI/output)
#   MODEL_UNET           — UNet model filename (default: flux-2-klein-4b-fp8.safetensors)
#   MODEL_CLIP           — CLIP model filename (default: Qwen3-4B-Q4_K_M.gguf)
#   MODEL_VAE            — VAE model filename (default: flux2_klein_vae.safetensors)

# Required
DESIGNER_MCP_TOKEN=
PUBLIC_URL_BASE=

# Optional
# DISCORD_WEBHOOK_URL=
# HOST=0.0.0.0
# PORT=8003
# COMFYUI_URL=http://127.0.0.1:8188
# COMFYUI_DIR=~/ComfyUI
# DB_PATH=./imagine.db
# OUTPUT_DIR=~/ComfyUI/output
# MODEL_UNET=flux-2-klein-4b-fp8.safetensors
# MODEL_CLIP=Qwen3-4B-Q4_K_M.gguf
# MODEL_VAE=flux2_klein_vae.safetensors
